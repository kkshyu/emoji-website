# 正式站 Zeabur 環境變數範本
# 匯入：先選定服務，再 `zeabur variable env -f zeabur.env.example`（或於面板貼上）
# 機敏值（<...>）由你自行填入／更新；PORT 由 Zeabur 自動注入，勿設。

# ── 非機敏（可直接使用） ─────────────────────────────
PUBLIC_ORIGIN=https://www.emoji.tw
WEB_ORIGINS=https://www.emoji.tw,https://emoji.tw
MEMBERSHIP_START=2026-11-01
MAX_PARTICIPANTS=100

# ── 後台管理：改以 Google 帳號認定超級管理員（無登入代碼）──
# 預設超管為 us@twouring.com；如需更改才設此變數。超管可於後台指派其他管理員。
SUPER_ADMIN_EMAIL=us@twouring.com

# ── 機敏（自行填入） ─────────────────────────────────
APP_SECRET=<32+ 字元隨機字串>
PII_KEY=<個資加密金鑰，建議獨立於 APP_SECRET>
STRIPE_SECRET_KEY=<sk_live_...>
GOOGLE_CLIENT_ID=<...apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<...>

# ── 資料庫 ───────────────────────────────────────────
# 於 Zeabur 建立 Postgres 服務後，將其連線字串綁到此變數
# （server.js 亦接受 POSTGRES_CONNECTION_STRING 或 POSTGRES_* 個別變數）
DATABASE_URL=<postgres://user:pass@host:5432/dbname>
