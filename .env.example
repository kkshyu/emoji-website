# Stripe sandbox（測試環境）— website 與 fellow 共用
# 複製為 .env 後填入實際金鑰。本檔可入版控，.env 不可。

# 公開金鑰：website 前端與 fellow 前端共用
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# 私密金鑰：僅 fellow 後端使用
STRIPE_SECRET_KEY=sk_test_xxx

# Google 登入（官網會員專區）— 僅 fellow 後端使用
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
# 本地測試讓 Google 導回本機 fellow；正式環境留空用預設 https://fellow.emoji.tw
# FELLOW_ORIGIN=http://localhost:8080
# 官網來源白名單（CORS 與登入導回防護），逗號分隔；預設已含 www/emoji.tw 與 localhost:5500
# WEB_ORIGINS=https://www.emoji.tw,https://emoji.tw
